{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marsa",
  "version": "0.1.0",
  "identifier": "io.github.marsa-app.marsa",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Marsa",
        "width": 1240,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlEMkI4RDBFQjI0Mjc4QkMKUldTOGVFS3lEbzBybmNXWS8zZjkwQ09UWktwUEJGaXlqWWFWbG8vREJhRDJUdVN4UnhmWkFORWwK",
      "endpoints": [
        "https://github.com/dentalproo/marsa-download-manager/releases/download/updater/latest.json"
      ],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Marsa",
    "copyright": "Copyright © 2026 Marsa contributors",
    "category": "Utility",
    "shortDescription": "A calm, fast, Arabic-first download manager for Windows.",
    "longDescription": "Marsa downloads files in parallel, resumes them after a disconnect, and keeps your queue, categories and speed limits in one quiet window.",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Marsa",
        "displayLanguageSelector": false,
        "languages": ["Arabic", "English"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/welcome-sidebar.bmp"
      }
    }
  }
}
